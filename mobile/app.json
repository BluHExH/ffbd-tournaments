{
  "expo": {
    "name": "BANGLAR TOURNAMENTS",
    "slug": "sawon",
    "scheme": "banglartournaments",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "icon": "./banglar-tournaments-app-icon.png",
    "splash": {
      "image": "./banglar-tournaments-app-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#07110B"
    },
    "platforms": ["ios", "android", "web"],
    "plugins": [
      "expo-router",
      ["expo-secure-store", { "configureAndroidBackup": true }],
      "expo-font"
    ],
    "android": {
      "package": "com.banglartournaments.app",
      "icon": "./banglar-tournaments-app-icon-padded.png",
      "adaptiveIcon": {
        "foregroundImage": "./banglar-tournaments-app-icon-padded.png",
        "backgroundColor": "#07110B"
      },
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": false,
          "category": ["BROWSABLE", "DEFAULT"],
          "data": [
            {
              "scheme": "banglartournaments",
              "host": "reset-password"
            },
            {
              "scheme": "banglartournaments",
              "pathPrefix": "/reset-password"
            }
          ]
        }
      ]
    },
    "ios": {
      "bundleIdentifier": "com.banglartournaments.app",
      "supportsTablet": true,
      "icon": "./banglar-tournaments-app-icon.png"
    },
    "experiments": { "typedRoutes": true },
    "extra": {
      "router": {},
      "eas": { "projectId": "3d8daf5c-32f7-4b88-b03f-a5d7dca93aea" }
    },
    "owner": "sawon-islams-team"
  }
}
